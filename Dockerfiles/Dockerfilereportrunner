FROM python:3.11.3-alpine
LABEL maintainer="lapin"

# Install build dependencies and upgrade pip
RUN apk add --no-cache --virtual .build-deps \
    gcc \
    g++ \
    gfortran \
    musl-dev \
    libffi-dev \
    libxml2-dev \
    libxslt-dev \
    jpeg-dev \
    zlib-dev \
    freetype-dev \
    openblas-dev \
    && apk add --no-cache \
    libxml2 \
    libxslt \
    jpeg \
    freetype \
    openblas

COPY ./sources/requirements7.txt /opt/sources/requirements.txt
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /opt/sources/requirements.txt && \
    apk del .build-deps

