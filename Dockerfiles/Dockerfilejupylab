FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
	PYTHONUNBUFFERED=1 \
	JUPYTER_TOKEN=LeMotDePasse \
	JUPYTER_BASE_URL=/

WORKDIR /workspace

RUN pip install --no-cache-dir --upgrade pip \
	&& pip install --no-cache-dir jupyterlab

EXPOSE 8888

CMD ["sh", "-c", "jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root --ServerApp.password= --ServerApp.base_url=\"${JUPYTER_BASE_URL}\" --ServerApp.token=\"${JUPYTER_TOKEN:?Set JUPYTER_TOKEN}\""]
